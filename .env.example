# Shiksha Sahayak Configuration
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000

# SQLite Database
DATABASE_PATH=data/shiksha_sahayak.db

# Storage Directories
UPLOAD_FOLDER=data/uploads
PROCESSED_FOLDER=data/processed

# Gemini API Key (Required for AI generation & RAG)
GEMINI_API_KEY=your_gemini_api_key_here
